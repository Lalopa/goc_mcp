GOC_API_URL=https://api.goc.com/api/v2
MCP_BASE_URL=https://mcp.goc.com
PORT=3002
# Saltos de proxy de confianza delante del MCP (entero >= 0; por defecto 1). De esto depende la IP del limitador.
# Debe ser igual al número real de proxies: con MÁS saltos reales todos comparten la IP del proxy;
# con MENOS saltos reales, la IP la escribe el cliente (X-Forwarded-For) y es falsificable.
TRUST_PROXY_HOPS=1
